苹果脚本切换Fn键：
on run {input, parameters}
	
	set osver to system version of (system info)
	
	
	open location "x-apple.systempreferences:com.apple.Keyboard-Settings.extension"
	
	tell application "System Events" to tell process "System Settings"
		# example window title: "Keyboard – ￼86%", so "begins with" is needed
		repeat until window begins with "Keyboard" exists
		end repeat
		
		# wait until Keyboard window is the main window of the application and is accessible
		repeat until exists of (1st window whose value of attribute "AXMain" is true)
		end repeat
		
		# wait until the group is displayed (needed else fails on Apple M2 Pro)
		repeat until exists group 1 of group 2 of splitter group 1 of group 1 of window 1
		end repeat
		
		# 等待到UI刷出来
		repeat until exists group 2 of scroll area 1 of group 1 of group 2 of splitter group 1 of group 1 of window 1
		end repeat
		
		# 这一句用来调试查看布局
		# return every UI element of group 2 of scroll area 1 of group 1 of group 2 of splitter group 1 of group 1 of window 1
		# return name of every UI element of front window
		
		# "Keyboard Shortcuts..." Button
		click button 3 of group 2 of scroll area 1 of group 1 of group 2 of splitter group 1 of group 1 of window 1
		
		repeat until sheet 1 of window 1 exists
		end repeat
		
		# Click Function Keys 这个按键貌似没用因为现在是中文系统菜单不是F开头
		# keystroke "f"
		# 组合键写法例子 key code 53 using {command down, option down}
		# 直接组合键拉到最下，然后向上一个
		key code 125 using {option down}
		
		# 向上翻一个
		key code 126
		
		# "Use F1, F2, etc. keys as standard function keys"需要改成中文"将F1、F2等键用作标准功能键"
		repeat until checkbox "将F1、F2等键用作标准功能键" of group 1 of scroll area 1 of group 2 of splitter group 1 of group 1 of sheet 1 of window 1 exists
			# 不断上翻,目前上面已经翻了一次翻好了
			# 注意不要不停上翻,否则容易导致用户无法操作
			# key code 126
		end repeat
		
		click checkbox "将F1、F2等键用作标准功能键" of group 1 of scroll area 1 of group 2 of splitter group 1 of group 1 of sheet 1 of window 1
		
		# 延时一下好看清现在的状态 # beep 2
		
		# "Done" Button - Close the sheet so the application can quit
		click button 1 of group 2 of splitter group 1 of group 1 of sheet 1 of window 1
		
		# Attempting to check the sheet at a certain point while closing will throw an error
		# In that case, the outer repeat will try again
		repeat
			try
				repeat while sheet 1 of window 1 exists
				end repeat
				exit repeat
			end try
		end repeat
	end tell
	
	tell application "System Settings" to quit
	return input
end run
