function FindProxyForURL(url, host) {
  const targetDomains = [
    "*.google.*",
    "*.googletagmanager.com",
    "*.google-analytics.com",
    "*.googleapis.com",
    "*.gstatic.com",
    "*.ggpht.com",
    "*.googleusercontent.com",
    "*.googlevideo.com",
    "*.appspot.com",
    "*.youtube.com",
    "*.ytimg.com",
    "*.youtu.be",
    "*.proton.me",
    "*pornhub.com",
    "*.t66y.com",
    "*.phncdn.com",
    "*.github.com",
    "github.com",
    "*.github.*",
    "*.github*",
    "*.githubassets.com",
    "*.githubusercontent.com",
    "*.lumalabs.ai",
    "*.cdn-luma.com",
    "*.openai.com",
    "*.oaistatic.com",
    "*.oaiusercontent.com",
    "*.chatgpt.com",
    "chatgpt.com",
    "*.chatgpt.*",
    "*.ipinfo.io",
    "*.clarity.ms",
    "*.wikimedia.org",
    "*.wikipedia.org",
    "*.huggingface.co",
    "huggingface.co",
    "*.apkpure.com",
    "apkpure.com",
    "astronomy.com",
    "animalia-life.club",
    "*.twitter.com",
    "*.x.com",
    "*.x.*",
    "*.grok.com",
    "*.doubleclick.net",
    "*.gatekeeperconsent.com",
    "*.humix.com",
    "grok.com",
    "*.facebook.com",
    "*.fbcdn.net",
    "*.fbsbx.com",
    "*.gradio.com",
    "*.nasuyun.com",
    "*.pexels.com",
    "*yt1d.com",
    "*zoomnews.in",
    "*inspiredpencil.com",
    "*.gofrp.org",
    "*.savefrom.net",
    "*.y2mate.com",
    "*.qobuz.com",
    "*.reddit.com",
    "*.madeinse.co",
    "*.hk01.com",
    "*.theguardian.com",
    "*.istockphoto.com",
    "*.bbc.co.*",
    "*.bbci.co.*",
    "*.morethanadodo.com",
    "*.oracle.com",
    "*.cloudns.net",
    "*.steamcommunity.com",
    "*.v2ex.com",
  ];

  for (let domain of targetDomains) {
    if (shExpMatch(host, domain)) {
      return "SOCKS5 192.168.10.1:1083";
    }
  }
  return "DIRECT"; // 其他直连
}
